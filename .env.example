# =====================================================================
# Configuração da loja (white-label). Copie para .env.local (dev) ou
# cadastre na Vercel: Project > Settings > Environment Variables.
# Tudo que for NEXT_PUBLIC_* entra no build: mudou? faça Redeploy.
# Deixou vazio? Usa o padrão da loja de demonstração (Açaí Mania).
# =====================================================================

# ---------- Banco de dados (OBRIGATÓRIO para cada cliente) ----------
# Supabase > Project Settings > API (ou Data API): Project URL e a chave
# "anon"/"publishable". NUNCA use aqui a chave service_role/secret.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ---------- Identidade ----------
NEXT_PUBLIC_LOJA_NOME=Açaí do Bairro
# Nome curto do app instalado no celular (até ~12 letras)
NEXT_PUBLIC_LOJA_NOME_CURTO=Açaí Bairro
NEXT_PUBLIC_LOJA_SLOGAN=O melhor açaí da cidade, na sua porta
# Logo e banner: arquivo em /public (ex.: /logo.jpg) ou URL https completa.
# Logo de preferência quadrada, 512x512.
NEXT_PUBLIC_LOJA_LOGO=/logo.jpg
NEXT_PUBLIC_LOJA_BANNER=/copo.jpg

# ---------- Cores (hexadecimal) ----------
NEXT_PUBLIC_LOJA_COR_PRIMARIA=#4A1259
NEXT_PUBLIC_LOJA_COR_DESTAQUE=#C2185B
NEXT_PUBLIC_LOJA_COR_FUNDO=#F6EEF8

# ---------- Contato e funcionamento ----------
# WhatsApp da loja: só números, com DDI 55 + DDD (ex.: 5567999990000)
NEXT_PUBLIC_LOJA_WHATSAPP=5567999990000
NEXT_PUBLIC_LOJA_ENDERECO=Rua Exemplo, 123 - Centro
# Cidade usada nas rotas do Google Maps do motoboy
NEXT_PUBLIC_LOJA_CIDADE=Aquidauana - MS
NEXT_PUBLIC_LOJA_HORARIO=Ter–Dom · 13h às 23h
# Prefixo do número do pedido (#AB-1A2B)
NEXT_PUBLIC_LOJA_PREFIXO_PEDIDO=AB

# ---------- Pagamento ----------
# Chave Pix mostrada no acompanhamento do pedido (vazio = loja manda pelo WhatsApp)
NEXT_PUBLIC_LOJA_PIX_CHAVE=
NEXT_PUBLIC_LOJA_PIX_NOME=

# ---------- Redes sociais (opcional) ----------
NEXT_PUBLIC_LOJA_INSTAGRAM=@sualoja
NEXT_PUBLIC_LOJA_FACEBOOK=
NEXT_PUBLIC_LOJA_SITE=

# ---------- Entrega ----------
# Bairros e taxas são editados no /admin > Frete (tabela delivery_zones).
# Esta lista só é usada se a tabela estiver vazia. Formato: Bairro:taxa, Bairro:taxa
NEXT_PUBLIC_LOJA_BAIRROS=Centro:4, Alto:5, Outro:8
# Pedido mínimo para entrega em R$ (0 = sem mínimo)
NEXT_PUBLIC_LOJA_PEDIDO_MINIMO=0

# ---------- Monte seu açaí ----------
# Tamanhos e preços. Formato: tamanho:preço, tamanho:preço
NEXT_PUBLIC_LOJA_TAMANHOS=330ml:10, 440ml:13, 550ml:16
# Acompanhamentos (opcional, JSON numa linha só). Vazio = padrão.
# Exemplo: [{"id":"frutas","label":"Frutas","max":3,"options":["Banana","Morango"]}]
NEXT_PUBLIC_LOJA_ACOMPANHAMENTOS=
